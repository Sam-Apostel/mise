# Copy to `.env` for local server runs, or set these as Railway variables.

# Anthropic Messages API key. When unset, the server uses a heuristic parser
# so it still runs end-to-end without an LLM.
ANTHROPIC_API_KEY=

# Model used for menu parsing. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# Port the server binds to. Railway injects this automatically.
PORT=8080

# T-Minus (https://t-min.sams.works) project ingest key. When set, 5xx errors are
# reported there; when unset, nothing is sent.
TMINUS_KEY=
# Only for a self-hosted T-Minus hub.
# TMINUS_URL=
